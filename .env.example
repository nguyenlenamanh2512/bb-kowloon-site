# Public URL used in canonical metadata, robots.txt and sitemap.xml.
SITE_URL=https://www.bbKowloon.com

# Use a long random value in production to keep CMS sessions valid and secure.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Used only when storage/cms-data.json does not contain any accounts.
# Leave all three blank after the first administrator has been created.
CMS_BOOTSTRAP_USERNAME=
CMS_BOOTSTRAP_DISPLAY_NAME=
CMS_BOOTSTRAP_PASSWORD=

# Docker Compose settings.
APP_PORT=3000
BIND_ADDRESS=0.0.0.0
IMAGE_NAME=bb-kowloon-site:local
