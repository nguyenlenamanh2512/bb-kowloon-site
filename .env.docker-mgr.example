# Public address routed by the HAProxy VIP.
SITE_URL=https://www.example.com

# Generate a unique value with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret

# Required only for a fresh data directory. Use a unique password of at least 12 characters.
CMS_BOOTSTRAP_USERNAME=
CMS_BOOTSTRAP_DISPLAY_NAME=
CMS_BOOTSTRAP_PASSWORD=

# The website is reachable by HAProxy at DOCKER_MGR_PRIVATE_IP:3000.
APP_PORT=3000
BIND_ADDRESS=0.0.0.0
IMAGE_NAME=bb-kowloon-site:v1.0.0-local

# Persistent CMS JSON and uploaded files live here on docker-mgr.
DATA_PATH=/srv/bb-kowloon-v1/storage
